{
  "name": "mlp-fim-themes",
  "displayName": "Visual Studio Code MLP Themes",
  "description": "A Catppuccin-inspired pastel dark theme collection featuring the Mane 6 and the Princesses of Equestria, plus a smart theme switcher for VS Code, Cursor, Windsurf, and VSCodium.",
  "version": "1.0.0",
  "publisher": "Arviixzuh",
  "author": "Arviixzuh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "my little pony",
    "friendship is magic",
    "catppuccin",
    "pastel",
    "theme",
    "color theme"
  ],
  "icon": "assets/icons.png",
  "galleryBanner": {
    "color": "#141221",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arviixzuh/vscode-mlp-themes"
  },
  "bugs": {
    "url": "https://github.com/Arviixzuh/vscode-mlp-themes/issues"
  },
  "homepage": "https://github.com/Arviixzuh/vscode-mlp-themes#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Twilight Sparkle",
        "uiTheme": "vs-dark",
        "path": "./themes/twilight-sparkle.json"
      },
      {
        "label": "Rainbow Dash",
        "uiTheme": "vs-dark",
        "path": "./themes/rainbow-dash.json"
      },
      {
        "label": "Fluttershy",
        "uiTheme": "vs-dark",
        "path": "./themes/fluttershy.json"
      },
      {
        "label": "Rarity",
        "uiTheme": "vs-dark",
        "path": "./themes/rarity.json"
      },
      {
        "label": "Applejack",
        "uiTheme": "vs-dark",
        "path": "./themes/applejack.json"
      },
      {
        "label": "Pinkie Pie",
        "uiTheme": "vs-dark",
        "path": "./themes/pinkie-pie.json"
      },
      {
        "label": "Princess Luna",
        "uiTheme": "vs-dark",
        "path": "./themes/princess-luna.json"
      },
      {
        "label": "Princess Celestia",
        "uiTheme": "vs-dark",
        "path": "./themes/princess-celestia.json"
      },
      {
        "label": "Sunset Shimmer",
        "uiTheme": "vs-dark",
        "path": "./themes/sunset-shimmer.json"
      }
    ],
    "commands": [
      {
        "command": "mlpThemes.quickPickTheme",
        "title": "MLP Themes: Pick Theme",
        "category": "MLP Themes"
      },
      {
        "command": "mlpThemes.nextTheme",
        "title": "MLP Themes: Next Theme",
        "category": "MLP Themes"
      },
      {
        "command": "mlpThemes.setWorkspaceTheme",
        "title": "MLP Themes: Set Workspace Theme",
        "category": "MLP Themes"
      }
    ],
    "keybindings": [
      {
        "command": "mlpThemes.nextTheme",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "MLP Themes",
      "properties": {
        "mlpThemes.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the active MLP theme in the status bar with a quick-switcher."
        },
        "mlpThemes.autoSchedule.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch between a daytime and a nighttime theme based on the configured hours."
        },
        "mlpThemes.autoSchedule.dayTheme": {
          "type": "string",
          "default": "Princess Celestia",
          "enum": [
            "Twilight Sparkle",
            "Rainbow Dash",
            "Fluttershy",
            "Rarity",
            "Applejack",
            "Pinkie Pie",
            "Princess Luna",
            "Princess Celestia",
            "Sunset Shimmer"
          ],
          "description": "Theme applied during daytime hours."
        },
        "mlpThemes.autoSchedule.nightTheme": {
          "type": "string",
          "default": "Princess Luna",
          "enum": [
            "Twilight Sparkle",
            "Rainbow Dash",
            "Fluttershy",
            "Rarity",
            "Applejack",
            "Pinkie Pie",
            "Princess Luna",
            "Princess Celestia",
            "Sunset Shimmer"
          ],
          "description": "Theme applied during nighttime hours."
        },
        "mlpThemes.autoSchedule.dayStartHour": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour (0-23, local time) at which the daytime theme begins."
        },
        "mlpThemes.autoSchedule.nightStartHour": {
          "type": "number",
          "default": 19,
          "minimum": 0,
          "maximum": 23,
          "description": "Hour (0-23, local time) at which the nighttime theme begins."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:themes": "npm run compile && node out/palette-generator.js",
    "lint": "tsc -p . --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "ovsx": "^0.10.4",
    "typescript": "^5.6.3"
  }
}
